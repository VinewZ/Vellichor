# Required: URL of your running Kokoro TTS server.
# There is no default — the app refuses render/proxy calls without it,
# because 127.0.0.1 inside a container never reaches your host.
# Local dev:        http://127.0.0.1:8880
# Docker (Desktop): http://host.docker.internal:8880
# Docker (Linux):   http://<host-LAN-IP>:8880  (e.g. http://192.168.1.10:8880)
KOKORO_BASE_URL=http://127.0.0.1:8880

# Optional: Bearer token when your Kokoro install requires auth.
# Fresh persistent Kokoro installs auto-generate one — copy it here.
# Leave commented out when Kokoro auth is disabled. Never exposed to the browser.
#KOKORO_API_KEY=

# Where rendered chapters, manifests and exports live.
# In compose this is the named volume mounted at /data.
DATA_DIR=./data

# Port the web UI listens on.
PORT=3000

# Only set these if ffmpeg / ffprobe are NOT on PATH
# (the Docker image already has both).
#FFMPEG_PATH=/usr/bin/ffmpeg
#FFPROBE_PATH=/usr/bin/ffprobe
