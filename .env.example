# Single env file for the whole stack. Each compose service picks only
# the vars it needs (see compose.yml `environment:`), so Kokoro never
# sees Vellichor vars and vice versa.

# ---- Kokoro (shared by both services) ----
# URL of the Kokoro TTS server. No default — Vellichor refuses
# render/proxy calls without it.
# Local dev:        http://127.0.0.1:8880
# Merged compose:   http://kokoro:8880
# Docker (Desktop, external Kokoro): http://host.docker.internal:8880
# Docker (Linux, external Kokoro):   http://<host-LAN-IP>:8880
KOKORO_BASE_URL=http://kokoro:8880

# Optional: Bearer token when Kokoro requires auth.
# Must be identical to the key in kokoro.env. Leave commented out
# when Kokoro auth is disabled. Never exposed to the browser.
#KOKORO_API_KEY=

# ---- Vellichor ----
# Port the web UI listens on (host side).
VELLICHOR_PORT=3000

# Where rendered chapters, manifests and exports live.
# Local dev default: ./data  |  merged compose: /data (mounted at ./data/vellichor)
VELLICHOR_DATA_DIR=./data

# Only set these if ffmpeg / ffprobe are NOT on PATH
# (the Docker image already has both).
#VELLICHOR_FFMPEG_PATH=/usr/bin/ffmpeg
#VELLICHOR_FFPROBE_PATH=/usr/bin/ffprobe
