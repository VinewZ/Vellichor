# Vellichor env file. One file feeds both services: compose injects
# these values as container env, so Kokoro and Vellichor share the
# KOKORO_* lines below by construction. Full Kokoro var list:
# https://github.com/hwdsl2/docker-kokoro#environment-variables

# ---- Kokoro reachability (Vellichor side) ----
# Leave commented: compose defaults to the same-compose service
# (http://kokoro:8880). Uncomment only for an external Kokoro.
#KOKORO_BASE_URL=http://127.0.0.1:8880
# Docker Desktop (external Kokoro): http://host.docker.internal:8880
# Docker Linux (external Kokoro):   http://<host-LAN-IP>:8880

# Kokoro auth. Empty = public access (compose passes the empty value,
# which disables authentication). Set a value to require Bearer auth
# on every request — Vellichor sends it automatically.
# Note: a Kokoro started with this variable absent entirely auto-generates
# a key instead (check with: docker exec kokoro kokoro_manage --showkey).
KOKORO_API_KEY=

# ---- Vellichor ----
# Port the web UI listens on (host side).
VELLICHOR_PORT=5257

# Only set these if ffmpeg / ffprobe are NOT on PATH
# (the Docker image already has both).
#VELLICHOR_FFMPEG_PATH=/usr/bin/ffmpeg
#VELLICHOR_FFPROBE_PATH=/usr/bin/ffprobe
